generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  events    Event[]
  tickets   Ticket[]
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  totalSeats  Int
  availableSeats Int
  createdAt   DateTime @default(now())

  creatorId String
  creator   User @relation(fields: [creatorId], references: [id])

  tickets   Ticket[]
}

model Ticket {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}